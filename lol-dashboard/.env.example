# Get a dev key at https://developer.riotgames.com/ (expires every 24h, regenerate as needed)
RIOT_API_KEY=RGAPI-RGAPI-0c02db76-7f33-410e-8817-b70e2aa67b46

# Your Riot ID (the name#tag shown in-game, e.g. Faker#KR1)
RIOT_GAME_NAME=YourName
RIOT_TAG_LINE=TAG

# Routing region for your account's platform (na1, euw1, kr, etc.)
PLATFORM_REGION=na1

# Continental routing for match history (americas, europe, asia, sea)
CONTINENTAL_REGION=americas

# How many recent matches to pull (paginated past Riot's 100-per-call cap).
# Higher = longer first load on a rate-limited dev key (~1.3s per uncached
# match). Cached matches reload instantly on future runs.
MATCH_HISTORY_TARGET=1000

# Optional — only set this if your League client saves replays somewhere
# other than the default (Documents\League of Legends\Replays on Windows).
# Used by the Highlight Reel's replay finder to locate local .rofl files.
# REPLAY_FOLDER=C:\Path\To\Your\Replays

# Optional — which champion's splash art/icon is used for the hero banner
# across the site. Set automatically the first time you pick one in the
# sidebar Settings panel; defaults to Kindred if unset.
# HERO_CHAMPION=Kindred

# Optional — your climb goal, shown on the Home page's Climb Goal card. Set
# automatically the first time you save one in Settings. Tier is one of
# IRON/BRONZE/SILVER/GOLD/PLATINUM/EMERALD/DIAMOND/MASTER/GRANDMASTER/
# CHALLENGER; division is I/II/III/IV (leave blank for Master+).
# GOAL_TIER=PLATINUM
# GOAL_RANK=IV
